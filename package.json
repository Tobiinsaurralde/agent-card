{
  "name": "agent-card",
  "version": "0.0.1",
  "private": true,
  "description": "Capa de control con defaults seguros para tarjetas de agentes. Provider-agnostic.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "harness": "node --import tsx harness/run.ts",
    "recon:stripe": "node --import tsx harness/recon-stripe.ts",
    "mcp": "node --import tsx src/mcp/bin.ts",
    "test:checkout": "node --env-file=.env --import tsx src/bin/checkout-test.ts",
    "pay": "node --env-file=.env --import tsx src/bin/mcp-pay.ts",
    "test:porkbun": "node --env-file=.env --import tsx src/bin/porkbun-test.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "author": "Tobias Insaurralde",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "lucide-react": "^1.33.0",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  }
}
