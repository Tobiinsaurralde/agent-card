# Browser del checkout (Steel). Sin esto, el captcha no se resuelve de verdad.
# https://app.steel.dev → Settings → API Keys
STEEL_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Porkbun por API: el camino sin browser, sin formulario y sin captcha.
# Claves en https://porkbun.com/account/api
#
# Ojo con el modelo de plata: Porkbun cobra CRÉDITO DE LA CUENTA, no la tarjeta
# en cada compra. La tarjeta carga el crédito una vez y el agente gasta de ahí.
# ─────────────────────────────────────────────────────────────────────────────
PORKBUN_API_KEY=
PORKBUN_SECRET_API_KEY=

# Gate para que un `create` cobre de verdad. Sin esto en 1, sólo corre el dryRun.
AGENT_CARD_ALLOW_REAL_PURCHASE=

# ─────────────────────────────────────────────────────────────────────────────
# Tarjeta real, SOLO para el test de compra online (npm run test:checkout).
#
# Esto mete el número en nuestro proceso, que es justo lo que el diseño prohíbe
# en producción (docs/spec.md §3.1). Existe porque no hay otra forma de medir si
# una tarjeta que ya existe pasa un checkout.
#
# Dos reglas:
#   · Usá una tarjeta VIRTUAL con límite bajo, nunca la principal. La tarjeta
#     termina en el navegador que maneja el agente.
#   · .env está en .gitignore. No lo saques de ahí ni pegues estos valores en
#     un chat, un issue o un log.
# ─────────────────────────────────────────────────────────────────────────────

# Gate explícito. Sin esto en 1, el código se niega a leer la tarjeta.
AGENT_CARD_ALLOW_MANUAL_PAN=

AGENT_CARD_TEST_PAN=
AGENT_CARD_TEST_EXP=
AGENT_CARD_TEST_CVC=
AGENT_CARD_TEST_NAME=

# Perfil del comprador: el agente lo usa para crear la cuenta del comercio.
# Sin esto, un dominio no se puede comprar sin que un humano toque el checkout.
AGENT_CARD_TEST_EMAIL=
AGENT_CARD_TEST_PASSWORD=
AGENT_CARD_TEST_COUNTRY=AR
AGENT_CARD_TEST_STREET=
AGENT_CARD_TEST_CITY=
AGENT_CARD_TEST_REGION=
AGENT_CARD_TEST_POSTAL=
AGENT_CARD_TEST_PHONE=
